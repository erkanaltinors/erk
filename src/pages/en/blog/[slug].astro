---
import Layout from "@/layouts/Layout.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";

interface Props {
	entry: CollectionEntry<"blog_en">;
}

export async function getStaticPaths() {
	const blogEntries = await getCollection("blog_en");
	return blogEntries.map((entry) => {
		return { params: { slug: entry.id }, props: { entry } };
	});
}
// 2. For your template, you can get the entry directly from the prop
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} lang="en" description={entry.data.description}>
<meta property="article:author" content="Erkan Altınörs" slot="author"/>
<meta property="og:type" content="article" slot="page-type" />
 <section class="pb-10">
  <div class="container max-w-150">
   <h1 class="text-4xl md:text-5xl mt-4">{entry.data.title}</h1>
   <p class="text-xl md:text-2xl text-gray-600 mb-8">{entry.data.description}</p>
   <div class="blog-wrapper">
       <Content />
   </div>
  </div>
 </section>
</Layout>
